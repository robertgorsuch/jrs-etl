      <uiProperties shellMaximized="false"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="false">
        <mapperTableEntries expression="StringHandling.TRIM(row1.full_name)" name="clean_name" type="id_String"/>
        <mapperTableEntries expression="row1.email == null ? null : StringHandling.DOWNCASE(row1.email)" name="clean_email" type="id_String"/>
      </varTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" minimized="false">
        <mapperTableEntries name="customer_id" type="id_Integer" nullable="false"/>
        <mapperTableEntries name="full_name" type="id_String" nullable="true"/>
        <mapperTableEntries name="email" type="id_String" nullable="true"/>
