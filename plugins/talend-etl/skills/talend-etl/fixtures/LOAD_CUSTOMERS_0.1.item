        <mapperTableEntries name="lifetime_value" type="id_BigDecimal" nullable="true"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="lkp" minimized="false" lookupMode="LOAD_ONCE" matchingMode="UNIQUE_MATCH" innerJoin="true">
        <mapperTableEntries expression="StringHandling.UPCASE(row1.country_code)" name="country_code" type="id_String" nullable="false" operator="=="/>
        <mapperTableEntries name="country_name" type="id_String" nullable="true"/>
        <mapperTableEntries name="region" type="id_String" nullable="true"/>
      </inputTables>
      <outputTables sizeState="INTERMEDIATE" name="out_ok" minimized="false" activateExpressionFilter="true" expressionFilter="Var.clean_email != null &amp;&amp; Var.clean_email.contains(&quot;@&quot;)">
        <mapperTableEntries expression="row1.customer_id" name="customer_id" type="id_Integer" nullable="false"/>
        <mapperTableEntries expression="Var.clean_name" name="full_name" type="id_String" nullable="true"/>
        <mapperTableEntries expression="Var.clean_email" name="email" type="id_String" nullable="true"/>
        <mapperTableEntries expression="lkp.country_name" name="country_name" type="id_String" nullable="true"/>
        <mapperTableEntries expression="lkp.region" name="region" type="id_String" nullable="true"/>
        <mapperTableEntries expression="row1.signup_date" name="signup_date" type="id_Date" nullable="true"/>
        <mapperTableEntries expression="row1.lifetime_value" name="lifetime_value" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries expression="TalendDate.getCurrentDate()" name="load_ts" type="id_Date" nullable="true"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="out_no_country" minimized="false" rejectInnerJoin="true">
        <mapperTableEntries expression="row1.customer_id" name="customer_id" type="id_Integer" nullable="false"/>
        <mapperTableEntries expression="row1.country_code" name="country_code" type="id_String" nullable="true"/>
      </outputTables>
